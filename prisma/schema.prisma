generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { ADMIN MANAGER SALES VIEWER }
enum LeadStatus { NEW QUEUED CALLING CONTACTED INTERESTED QUALIFIED CALLBACK TRANSFERRED NOT_INTERESTED DO_NOT_CALL WRONG_NUMBER FAILED }
enum CampaignStatus { DRAFT SCHEDULED RUNNING PAUSED COMPLETED CANCELLED }
enum CallStatus { QUEUED INITIATED RINGING ANSWERED COMPLETED FAILED NO_ANSWER BUSY }
enum CallbackStatus { PENDING DUE COMPLETED CANCELLED MISSED }

model User { id String @id @default(cuid()) email String @unique passwordHash String role Role @default(SALES) name String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt leads Lead[] @relation("OwnerLeads") auditLogs AuditLog[] }
model Lead { id String @id @default(cuid()) name String? phone String @unique alternatePhone String? companyName String? email String? city String? state String? industry String? source String? languagePreference String? udyamStatus String? zedStatus String? interestLevel String? status LeadStatus @default(NEW) ownerId String? owner User? @relation("OwnerLeads", fields:[ownerId], references:[id]) lastContactedAt DateTime? nextCallbackAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt events LeadEvent[] calls Call[] campaignLinks CampaignLead[] callbacks Callback[] @@index([status,nextCallbackAt]) @@index([state,industry]) }
model LeadEvent { id String @id @default(cuid()) leadId String lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade) type String actor String metadata Json? occurredAt DateTime @default(now()) @@index([leadId,occurredAt]) }
model Campaign { id String @id @default(cuid()) name String description String? callingNumber String assistant String @default("Meera") language String @default("hinglish") timezone String @default("Asia/Kolkata") callingWindow Json maxConcurrentCalls Int @default(1) retryPolicy Json retryDelayMinutes Int @default(30) maxAttempts Int @default(3) startDate DateTime? endDate DateTime? humanTransferNumber String? recordingEnabled Boolean @default(false) status CampaignStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt leads CampaignLead[] calls Call[] @@index([status,startDate]) }
model CampaignLead { campaignId String campaign Campaign @relation(fields:[campaignId], references:[id], onDelete:Cascade) leadId String lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade) attemptCount Int @default(0) queuedAt DateTime? lastAttemptAt DateTime? @@id([campaignId,leadId]) @@index([campaignId,queuedAt]) }
model Call { id String @id @default(cuid()) leadId String lead Lead @relation(fields:[leadId], references:[id]) campaignId String? campaign Campaign? @relation(fields:[campaignId], references:[id]) providerCallId String? @unique direction String @default("OUTBOUND") fromNumber String toNumber String startedAt DateTime? answeredAt DateTime? endedAt DateTime? durationSeconds Int? status CallStatus @default(QUEUED) disconnectReason String? recordingReference String? summary String? customerIntent Json? interestScore Int? qualificationResult Json? callbackRequired Boolean @default(false) providerMetadata Json? events CallEvent[] transcript TranscriptSegment[] conversation Conversation? transfer Transfer? createdAt DateTime @default(now()) @@index([leadId,createdAt]) @@index([campaignId,status]) }
model CallEvent { id String @id @default(cuid()) callId String call Call @relation(fields:[callId],references:[id],onDelete:Cascade) eventKey String @unique type String payload Json occurredAt DateTime @default(now()) }
model TranscriptSegment { id String @id @default(cuid()) callId String call Call @relation(fields:[callId],references:[id],onDelete:Cascade) speaker String text String startedAt DateTime? endedAt DateTime? confidence Float? @@index([callId,startedAt]) }
model Conversation { id String @id @default(cuid()) callId String @unique call Call @relation(fields:[callId],references:[id],onDelete:Cascade) state String currentTurn Int @default(0) sourceReferences Json? updatedAt DateTime @updatedAt }
model Callback { id String @id @default(cuid()) leadId String lead Lead @relation(fields:[leadId],references:[id]) sourceCallId String? requestedAt DateTime @default(now()) scheduledFor DateTime timezone String reason String priority Int @default(0) ownerId String? status CallbackStatus @default(PENDING) notes String? @@index([status,scheduledFor]) }
model Transfer { id String @id @default(cuid()) callId String @unique call Call @relation(fields:[callId],references:[id],onDelete:Cascade) targetNumber String status String @default("REQUESTED") initiatedAt DateTime? connectedAt DateTime? failureReason String? }
model KnowledgeDocument { id String @id @default(cuid()) name String category String storageKey String checksum String version Int @default(1) active Boolean @default(false) createdAt DateTime @default(now()) chunks KnowledgeChunk[] @@unique([checksum,version]) @@index([category,active]) }
model KnowledgeChunk { id String @id @default(cuid()) documentId String document KnowledgeDocument @relation(fields:[documentId],references:[id],onDelete:Cascade) ordinal Int text String sourceLabel String embeddingRef String? @@unique([documentId,ordinal]) }
model SuppressionEntry { id String @id @default(cuid()) phone String @unique reason String sourceCallId String? createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) actorId String? actor User? @relation(fields:[actorId],references:[id]) action String entityType String entityId String requestId String metadata Json? createdAt DateTime @default(now()) @@index([entityType,entityId,createdAt]) @@index([requestId]) }
model SystemSetting { key String @id value Json updatedAt DateTime @updatedAt }
